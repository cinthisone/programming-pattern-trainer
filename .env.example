# Auth is off by default until Supabase keys exist.
# Set AUTH_DISABLED=false if you want to force sign-in without a database.
AUTH_DISABLED=true

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

JUDGE0_BASE_URL=
# Self-hosted: X-Auth-Token. Hosted subscription: that provider's API key.
JUDGE0_API_KEY=

AI_GATEWAY_API_KEY=
AI_MODEL=

ALLOW_GUEST_EXECUTION=false
MAX_SOURCE_CHARS=65536
MAX_TIMEOUT_MS=8000
